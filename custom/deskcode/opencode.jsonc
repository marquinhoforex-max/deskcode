{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-2.5-flash",
  "small_model": "google/gemini-2.5-flash",
  "enabled_providers": ["google"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000,
    "preserve_recent_tokens": 15000,
    "tail_turns": 50
  }
}
